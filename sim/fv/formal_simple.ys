#!/bin/bash
# ============================================================================
# formal_simple.ys - Simple Yosys Formal Verification without inline assertions
# ============================================================================

# Read all RTL files
read_verilog -sv ../../rtl/alu.sv
read_verilog -sv ../../rtl/rf.sv
read_verilog -sv ../../rtl/ctrl.sv
read_verilog -sv ../../rtl/imm_gen.sv
read_verilog -sv ../../rtl/pc.sv
read_verilog -sv ../../rtl/alu_ctrl.sv
read_verilog -sv ../../rtl/forward_unit.sv
read_verilog -sv ../../rtl/hazard_unit.sv
read_verilog -sv ../../rtl/rv32i.sv

# Simple test with just the core module
hierarchy -top rv32i

# Prepare design for formal
proc
opt
memory
flatten

# Formal preparation
async2sync
formalff -clk2ff
# Set initial state
setparam -type const rst_n 0
setparam -type const clk 0

# Run BMC (bounded model checking) - 20 cycles
write_smt2 -wires rv32i.smt2